# Published ports
FRONTEND_PORT=3564
PORT=8080

# PostgreSQL
# DB_PORT là host port. Containers kết nối tới postgres:5432.
DB_HOST=postgres
DB_PORT=5434
DB_USER=tkt_user
DB_PASSWORD=change-me
DB_NAME=bookingcare-website
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}?schema=public

# Application
NODE_ENV=development
FRONTEND_URL=http://localhost:3564
VITE_API_URL=http://localhost:8080/api/v1

# JWT - thay thế bằng chuỗi string ngẫu nhiên đủ dài
# Có thể dùng lệnh sau để tạo secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Google OAuth (Điền thông tin google oauth - đảm bảo URI trỏ về đoạn GOOGLE_CALLBACK_URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback

# Email (Resend: Điền thông tin Resend)
MAIL_PROVIDER=
MAIL_APP_NAME=
MAIL_FROM=
RESEND_API_KEY=

# Cloudinary(Điền thông tin cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# VNPay sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3564/payment-result

# AI provider (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
