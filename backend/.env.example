# Database (PostgreSQL - Prisma)
DB_HOST=localhost
DB_PORT=5434
DB_USER=tkt_user
DB_PASSWORD=123456
DB_NAME=bookingcare-website
DATABASE_URL="postgresql://tkt_user:123456@localhost:5434/bookingcare-website?schema=public"

# App
NODE_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:3564

# Email (Resend API over HTTPS)
MAIL_PROVIDER=resend
MAIL_APP_NAME=TKTBookingCare
MAIL_FROM="TKTBookingCare <no-reply@mail.simonthuan.dev>"
RESEND_API_KEY=

# JWT SECRET
# Có thể dùng lệnh sau để tạo secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Cloudinary upload storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=tktbookingcare

# VNPay config
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3564/payment-result

# AI provider (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
