# Database (PostgreSQL - Prisma)
DB_HOST=localhost
DB_PORT=5434
DB_USER=tkt_user
DB_PASSWORD=123456
DB_NAME=bookingcare-website
DATABASE_URL="postgresql://tkt_user:123456@localhost:5434/bookingcare-website?schema=public"

# App
NODE_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:3564

# JWT SECRET
# Có thể dùng lệnh sau để tạo secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Cookie
# Trên production đặt thành true (chỉ HTTPS)
COOKIE_SECURE=false